{% for entry in tables %}
  <div class="mb-3">
    {% component 'Card' with {title: entry.title, configUrl: loop.first ? configUrl : null} %}
      {% block content %}
        {% if entry.table.body is iterable and entry.table.body|length %}
          <div class="table-responsive">
            <table class="table">
              <thead>
                <tr>
                  {% for column in entry.table.header %}
                    <th class="{{ column.class }}">{{ column.title }}</th>
                  {% endfor %}
                </tr>
              </thead>
              <tbody>
                {% for row in entry.table.body %}
                  <tr>
                    {% for cell in row %}
                      <td class="{{ cell.class }}">{{ cell.wrapper_start|default('')|raw }}{{ cell.value|raw }}{{ cell.wrapper_end|default('')|raw }}</td>
                    {% endfor %}
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        {% elseif entry.table.body is iterable %}
          <p class="text-muted mb-0">{{ 'No data'|trans({}, 'Modules.Dashproducts.Admin') }}</p>
        {% else %}
          {{ entry.table.body|raw }}
        {% endif %}
      {% endblock %}
    {% endcomponent %}
  </div>
{% endfor %}
